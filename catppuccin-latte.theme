{
    "metadata": {
        "name": "Catppuccin Latte (tidymodels)",
        "revision": 1,
        "license": "SPDX-License-Identifier: MIT",
        "copyright": [
            "SPDX-FileCopyrightText: 2021 Catppuccin",
            "Light-mode companion to catppuccin-mocha.theme. Carries the same blue/sapphire -> pink, mauve -> yellow overrides as the Positron setup, applied with the literal override hex values (matching the 'all' scope in catppuccin.colorOverrides)."
        ]
    },
    "text-styles": {
        "Normal": { "text-color": "#4c4f69", "selected-text-color": "#4c4f69" },
        "Keyword": { "text-color": "#f9e2af", "selected-text-color": "#f9e2af", "bold": true },
        "ControlFlow": { "text-color": "#f9e2af", "selected-text-color": "#f9e2af", "bold": true },
        "Import": { "text-color": "#f9e2af", "selected-text-color": "#f9e2af" },
        "Preprocessor": { "text-color": "#f9e2af", "selected-text-color": "#f9e2af", "italic": true },
        "DataType": { "text-color": "#df8e1d", "selected-text-color": "#df8e1d" },
        "Attribute": { "text-color": "#df8e1d", "selected-text-color": "#df8e1d" },
        "Annotation": { "text-color": "#df8e1d", "selected-text-color": "#df8e1d", "italic": true },
        "DecVal": { "text-color": "#fe640b", "selected-text-color": "#fe640b" },
        "BaseN": { "text-color": "#fe640b", "selected-text-color": "#fe640b" },
        "Float": { "text-color": "#fe640b", "selected-text-color": "#fe640b" },
        "Constant": { "text-color": "#fe640b", "selected-text-color": "#fe640b", "bold": true },
        "Warning": { "text-color": "#fe640b", "selected-text-color": "#fe640b", "bold": true },
        "Others": { "text-color": "#fe640b", "selected-text-color": "#fe640b" },
        "String": { "text-color": "#40a02b", "selected-text-color": "#40a02b" },
        "VerbatimString": { "text-color": "#40a02b", "selected-text-color": "#40a02b" },
        "Extension": { "text-color": "#40a02b", "selected-text-color": "#40a02b", "bold": true },
        "Char": { "text-color": "#179299", "selected-text-color": "#179299" },
        "SpecialChar": { "text-color": "#ea76cb", "selected-text-color": "#ea76cb" },
        "SpecialString": { "text-color": "#ea76cb", "selected-text-color": "#ea76cb" },
        "Comment": { "text-color": "#7c7f93", "selected-text-color": "#7c7f93", "italic": true },
        "CommentVar": { "text-color": "#dd7878", "selected-text-color": "#dd7878", "italic": true, "bold": true },
        "Documentation": { "text-color": "#8c8fa1", "selected-text-color": "#8c8fa1", "italic": true },
        "RegionMarker": { "text-color": "#7c7f93", "selected-text-color": "#7c7f93", "italic": true },
        "Function": { "text-color": "#f5c2e7", "selected-text-color": "#f5c2e7" },
        "BuiltIn": { "text-color": "#f5c2e7", "selected-text-color": "#f5c2e7" },
        "Variable": { "text-color": "#4c4f69", "selected-text-color": "#4c4f69" },
        "Operator": { "text-color": "#04a5e5", "selected-text-color": "#04a5e5" },
        "Information": { "text-color": "#04a5e5", "selected-text-color": "#04a5e5", "bold": true },
        "Alert": { "text-color": "#d20f39", "selected-text-color": "#d20f39", "bold": true },
        "Error": { "text-color": "#d20f39", "selected-text-color": "#d20f39", "underline": true }
    },
    "background-color": "#eff1f5",
    "editor-colors": {
        "BackgroundColor": "#eff1f5",
        "CodeFolding": "#bcc0cc",
        "BracketMatching": "#8c8fa1",
        "CurrentLine": "#ccd0da",
        "IconBorder": "#e6e9ef",
        "IndentationLine": "#ccd0da",
        "LineNumbers": "#9ca0b0",
        "CurrentLineNumber": "#7c7f93",
        "MarkBookmark": "#7287fd",
        "MarkBreakpointActive": "#d20f39",
        "MarkBreakpointReached": "#df8e1d",
        "MarkBreakpointDisabled": "#9ca0b0",
        "MarkExecution": "#acb0be",
        "MarkWarning": "#fe640b",
        "MarkError": "#d20f39",
        "ModifiedLines": "#fe640b",
        "ReplaceHighlight": "#40a02b",
        "SavedLines": "#40a02b",
        "SearchHighlight": "#df8e1d",
        "TextSelection": "#acb0be",
        "Separator": "#bcc0cc",
        "SpellChecking": "#d20f39",
        "TabMarker": "#9ca0b0",
        "TemplateBackground": "#eff1f5",
        "TemplatePlaceholder": "#ccd0da",
        "TemplateFocusedPlaceholder": "#bcc0cc",
        "TemplateReadOnlyPlaceholder": "#bcc0cc",
        "WordWrapMarker": "#bcc0cc"
    }
}
